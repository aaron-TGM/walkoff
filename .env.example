# Supabase — use SERVICE_ROLE key in API routes, never the anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend — for new-signup notification emails and MCP sign-in codes.
# RESEND_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Walkoff <noreply@walkoff.io>
NOTIFICATION_EMAIL=aaron@walkoff.io

# MCP server (www.walkoff.io/mcp), see docs/mcp.md. Operators can use
# Walkoff for every brand in Claude; everyone else needs an invite
# (npm run brand -- invite). Comma-separated.
WALKOFF_OPERATOR_EMAILS=aaron@walkoff.io
# Optional: the public origin, when the request's own isn't right.
# WALKOFF_PUBLIC_URL=https://www.walkoff.io

# Site URL — used for metadata/og
NEXT_PUBLIC_SITE_URL=https://walkoff.io

# Moment engine (engine/), runs on Cloud Run, not Vercel. See engine/README.md.
# Uses SUPABASE_SERVICE_ROLE_KEY above. Without both values it runs as a dry run.
SUPABASE_URL=https://your-project.supabase.co
LEAGUES=nfl,nba,nhl,ncaaf,ncaab,epl,mlb

# Claude, for tagging brand catalogs: npm run affinity:tag (scripts/README.md).
# Or run `ant auth login` instead of setting a key.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: WALKOFF_TAG_MODEL (default: DEFAULT_MODEL in lib/affinity/claude-tagger.ts),
# WALKOFF_TAG_EFFORT (default medium)
