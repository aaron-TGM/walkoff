{
  "name": "walkoff-io",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "engine:dev": "tsx watch engine/main.ts",
    "engine:once": "ONCE=1 tsx engine/main.ts",
    "engine:test": "tsx --test \"engine/**/*.test.ts\"",
    "engine:build": "esbuild engine/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/engine.cjs",
    "test": "tsx --test \"engine/**/*.test.ts\" \"lib/**/*.test.ts\"",
    "brand": "tsx scripts/brand.ts",
    "affinity:tag": "tsx scripts/tag-catalog.ts",
    "affinity:geo": "tsx scripts/build-geo.ts && tsx scripts/build-teams.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/analytics": "^2.0.1",
    "next": "15.2.8",
    "papaparse": "^5.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "fflate": "^0.8.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
